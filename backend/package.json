{
  "name": "forkverse-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "migrate": "tsx --env-file=../.env src/db/migrate.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "eval": "tsx --env-file=../.env eval/runEval.ts"
  },
  "dependencies": {
    "@langchain/core": "^1.4.1",
    "@langchain/langgraph": "^1.7.4",
    "@langchain/langgraph-checkpoint-mongodb": "^1.5.1",
    "@langchain/mcp-adapters": "^2.0.3",
    "@langchain/mongodb": "^1.3.1",
    "@langchain/openai": "^1.8.4",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "mongodb": "^6.22.0",
    "node-cron": "^4.6.0",
    "openai": "^7.57.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/node-cron": "^3.0.11",
    "@types/ws": "^8.18.2",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
