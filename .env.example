# MongoDB Atlas: Connect -> Drivers -> Node.js connection string
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@agentic.j33le.mongodb.net/?retryWrites=true&w=majority&appName=agentic

# LLM (OpenAI-compatible)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Embeddings: LangChain OpenAIEmbeddings against the MongoDB embedding API.
# EMBEDDING_DIM must match the model and be set before the first migrate.
EMBEDDING_BASE_URL=https://ai.mongodb.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=voyage-4
EMBEDDING_DIM=1024

# Context.dev (needed once ingest runs)
CONTEXT_DEV_API_KEY=

# Production only (Caddy HTTPS)
DOMAIN=
