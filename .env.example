# MongoDB Atlas: Connect -> Drivers -> Node.js connection string
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@agentic.j33le.mongodb.net/?retryWrites=true&w=majority&appName=agentic

# LLM (OpenAI-compatible)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Gemini audio transcription for the Workspace research chat.
GEMINI_API_KEY=
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-transcribe

# Embeddings: LangChain OpenAIEmbeddings against the MongoDB embedding API.
# EMBEDDING_DIM must match the model and be set before the first migrate.
EMBEDDING_BASE_URL=https://ai.mongodb.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=voyage-4
EMBEDDING_DIM=1024

# Context.dev (needed once ingest runs)
CONTEXT_DEV_API_KEY=
# Live monitors: pull detected changes every N ms (0 = webhook only). Webhooks are registered
# only when PUBLIC_BASE_URL is a public https URL (e.g. the Azure backend URL).
MONITOR_POLL_MS=60000
# Screen every source's page text for propaganda before it is used for the claim graph
# (one extra LLM call per source; scrapes are shared with claim building). false = domain lists only.
AUTO_VET_SOURCES=true
# PUBLIC_BASE_URL=https://<backend-host>

# Demo timeline: true = in-memory mock graph streamed to the frontend over /ws (no MongoDB needed).
TIMELINE_MOCK=false

# Production: browser origins allowed to call the API cross-origin (comma-separated),
# e.g. https://<name>.azurestaticapps.net. Leave empty for local dev (Vite proxy).
CORS_ORIGINS=
# Docker only: set false to boot without running migrate (e.g. demo mode without MongoDB).
MIGRATE_ON_START=true

# Production only (Caddy HTTPS)
DOMAIN=
